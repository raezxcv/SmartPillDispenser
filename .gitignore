# ── IDE & OS ──────────────────────────────────────────────────
.idea/
.vscode/
*.iml
*.ipr
*.iws
.DS_Store
Thumbs.db
desktop.ini

# ── Flutter / Dart ─────────────────────────────────────────────
# (flutter_app/.gitignore handles most, these are safety nets)
flutter_app/build/
flutter_app/.dart_tool/
flutter_app/.flutter-plugins
flutter_app/.flutter-plugins-dependencies
flutter_app/.pub-cache/
flutter_app/.pub/
flutter_app/coverage/

# ── Android generated ──────────────────────────────────────────
flutter_app/android/.gradle/
flutter_app/android/captures/
flutter_app/android/local.properties
flutter_app/android/key.properties
flutter_app/android/app/debug/
flutter_app/android/app/profile/
flutter_app/android/app/release/

# ── iOS / macOS generated ──────────────────────────────────────
flutter_app/ios/Pods/
flutter_app/ios/.symlinks/
flutter_app/ios/Flutter/Flutter.framework/
flutter_app/ios/Flutter/Flutter.podspec
flutter_app/ios/Flutter/.last_build_id
flutter_app/macos/Pods/
flutter_app/macos/.symlinks/

# ── Secrets — NEVER commit these ──────────────────────────────
# google-services.json contains your Firebase API keys.
# Keep it out of public repos. Share via a secure channel.
flutter_app/google-services.json
flutter_app/android/app/google-services.json
flutter_app/GoogleService-Info.plist
*.keystore
*.jks

# ── Node / Web tooling ─────────────────────────────────────────
node_modules/
**/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Firebase emulator / hosting cache ─────────────────────────
firebase/.firebase/
firebase/functions/node_modules/
firebase/functions/lib/

# ── Misc ───────────────────────────────────────────────────────
*.log
*.tmp
*.bak

# Extra google-services copies in assets
flutter_app/assets/google-services*.json
