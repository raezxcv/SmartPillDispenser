rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    // ── Global collections accessed by Admin Console & Flutter App ──

    // Users Collection
    match /users/{uid} {
      allow read, write: if true;
    }

    // Devices & Hardware Fleet
    match /devices/{deviceId} {
      allow read, write: if true;
    }

    // Alerts & Notifications
    match /alerts/{alertId} {
      allow read, write: if true;
    }

    // Medication Schedules
    match /schedules/{scheduleId} {
      allow read, write: if true;
    }

    // Dispenser Compartments & Pill Inventory
    match /compartments/{compartmentId} {
      allow read, write: if true;
    }

    // Dispensing Activity Logs
    match /dispensingLogs/{logId} {
      allow read, write: if true;
    }

    // Emergency Distress SOS Requests
    match /emergencyRequests/{requestId} {
      allow read, write: if true;
    }

    // Audit & System Logs
    match /audit_logs/{logId} {
      allow read, write: if true;
    }

    // Pairing Tokens & Contacts
    match /pairing_tokens/{tokenId} {
      allow read, write: if true;
    }
    match /pairing_requests/{requestId} {
      allow read, write: if true;
    }
    match /pairings/{pairingId} {
      allow read, write: if true;
    }
    match /notifications/{uid} {
      allow read, write: if true;
      match /items/{itemId} {
        allow read, write: if true;
      }
    }
    match /sms_queue/{id} {
      allow read, write: if true;
    }

    // Catch-all for development & testing
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
